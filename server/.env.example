# --- Server ---
PORT=4000
CORS_ORIGIN=*

# --- Postgres ---
# Either set DATABASE_URL, or the discrete PG* vars below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whatsapp
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=whatsapp

# --- WhatsApp Cloud API ---
# Leave blank to run against seed data only (no live sending).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=changeme
WHATSAPP_GRAPH_VERSION=v21.0
