---
import BaseHead from '../components/BaseHead.astro';

// --- Mock data (swap for a real WhatsApp Business / Cloud API source later) ---
const stats = [
	{ label: 'Total Conversations', value: '1,284', delta: '+12.4%', up: true, icon: '💬' },
	{ label: 'Messages Sent', value: '8,932', delta: '+8.1%', up: true, icon: '📨' },
	{ label: 'Delivery Rate', value: '97.6%', delta: '+0.9%', up: true, icon: '✅' },
	{ label: 'Avg. Response Time', value: '2m 14s', delta: '-18s', up: true, icon: '⚡' },
];

const weekly = [
	{ day: 'Mon', sent: 980, read: 720 },
	{ day: 'Tue', sent: 1240, read: 980 },
	{ day: 'Wed', sent: 1100, read: 860 },
	{ day: 'Thu', sent: 1430, read: 1180 },
	{ day: 'Fri', sent: 1680, read: 1390 },
	{ day: 'Sat', sent: 920, read: 640 },
	{ day: 'Sun', sent: 580, read: 410 },
];
const maxSent = Math.max(...weekly.map((d) => d.sent));
const totalSent = weekly.reduce((a, d) => a + d.sent, 0).toLocaleString();

const conversations = [
	{ name: 'Aisha Khan', phone: '+92 300 1234567', preview: 'Thanks! Order confirmed ✅', time: '2m', unread: 0, status: 'read' },
	{ name: 'Bilal Traders', phone: '+92 321 9876543', preview: 'Can you share the catalogue?', time: '11m', unread: 3, status: 'delivered' },
	{ name: 'Sara Malik', phone: '+92 333 4455667', preview: 'Is COD available in Lahore?', time: '34m', unread: 1, status: 'delivered' },
	{ name: 'Hamza Store', phone: '+92 345 1122334', preview: 'Invoice sent. Awaiting payment', time: '1h', unread: 0, status: 'sent' },
	{ name: 'Nida Fatima', phone: '+92 301 7788990', preview: 'Great service, will order again!', time: '3h', unread: 0, status: 'read' },
];

const templates = [
	{ name: 'order_confirmation', category: 'Utility', language: 'en', status: 'Approved' },
	{ name: 'shipping_update', category: 'Utility', language: 'en', status: 'Approved' },
	{ name: 'eid_promo_2026', category: 'Marketing', language: 'ur', status: 'Pending' },
	{ name: 'feedback_request', category: 'Utility', language: 'en', status: 'Approved' },
	{ name: 'cart_reminder', category: 'Marketing', language: 'en', status: 'Rejected' },
];

const nav = [
	{ icon: '📊', label: 'Overview', active: true },
	{ icon: '💬', label: 'Conversations', active: false },
	{ icon: '📨', label: 'Broadcasts', active: false },
	{ icon: '🧩', label: 'Templates', active: false },
	{ icon: '👥', label: 'Contacts', active: false },
	{ icon: '⚙️', label: 'Settings', active: false },
];

const tick = (s: string) => (s === 'sent' ? '✓' : '✓✓');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="WhatsApp Business Dashboard"
			description="Overview of conversations, message delivery and templates for your WhatsApp Business account."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<div class="layout">
			<!-- Sidebar -->
			<aside class="sidebar" aria-label="Primary">
				<div class="brand">
					<span class="logo" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
							<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.16c-.25.69-1.45 1.32-1.99 1.36-.53.05-1.03.24-3.47-.72-2.92-1.15-4.78-4.13-4.93-4.32-.14-.2-1.18-1.57-1.18-3 0-1.42.75-2.12 1.01-2.41.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.41-.07.64.49.25.61.84 2.03.91 2.18.07.14.12.31.02.5-.09.2-.14.31-.28.48-.14.17-.29.38-.42.5-.14.14-.28.29-.12.57.16.29.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.22 1.37.28.14.44.12.6-.07.16-.2.69-.81.87-1.08.18-.27.36-.23.61-.14.25.09 1.59.75 1.86.89.27.14.45.21.52.32.07.12.07.66-.18 1.35Z" />
						</svg>
					</span>
					<div class="brand-text">
						<strong>WA Business</strong>
						<small>Dashboard</small>
					</div>
				</div>
				<nav class="nav" aria-label="Sections">
					{nav.map((n) => (
						<a class={n.active ? 'active' : ''} href="#" aria-current={n.active ? 'page' : undefined}>
							<span class="nav-ico" aria-hidden="true">{n.icon}</span> {n.label}
						</a>
					))}
				</nav>
				<div class="account">
					<div class="avatar" aria-hidden="true">B</div>
					<div class="account-text">
						<strong>Business Inc.</strong>
						<small class="online">Connected</small>
					</div>
				</div>
			</aside>

			<!-- Main -->
			<main class="main" id="main">
				<header class="topbar">
					<div>
						<h1>Overview</h1>
						<p>Here's what's happening with your WhatsApp Business account today.</p>
					</div>
					<div class="topbar-actions">
						<label class="search" aria-label="Search conversations">
							<span class="search-ico" aria-hidden="true">🔍</span>
							<input type="search" placeholder="Search conversations…" />
						</label>
						<button class="btn" type="button">
							<span aria-hidden="true">＋</span> New broadcast
						</button>
					</div>
				</header>

				<!-- KPI cards -->
				<section class="cards" aria-label="Key metrics">
					{stats.map((s) => (
						<article class="card">
							<div class="card-top">
								<span class="card-ico" aria-hidden="true">{s.icon}</span>
								<span class={`card-delta ${s.up ? 'up' : 'down'}`}>
									{s.up ? '▲' : '▼'} {s.delta}
								</span>
							</div>
							<span class="card-value">{s.value}</span>
							<span class="card-label">{s.label}</span>
						</article>
					))}
				</section>

				<div class="grid">
					<!-- Chart -->
					<section class="panel chart-panel" aria-label="Messages this week">
						<div class="panel-head">
							<div>
								<h2>Messages this week</h2>
								<p class="panel-sub">{totalSent} messages sent · last 7 days</p>
							</div>
							<div class="legend">
								<span><i class="dot sent"></i> Sent</span>
								<span><i class="dot read"></i> Read</span>
							</div>
						</div>
						<div class="chart" role="img" aria-label={`Bar chart of messages sent and read per day. Peak ${maxSent} on Friday.`}>
							{weekly.map((d) => (
								<div class="bar-col">
									<div class="bars">
										<div class="bar sent" style={`height:${(d.sent / maxSent) * 100}%`}>
											<span class="bar-tip">{d.sent}</span>
										</div>
										<div class="bar read" style={`height:${(d.read / maxSent) * 100}%`}></div>
									</div>
									<span class="bar-label">{d.day}</span>
								</div>
							))}
						</div>
					</section>

					<!-- Conversations -->
					<section class="panel" aria-label="Recent conversations">
						<div class="panel-head">
							<h2>Recent conversations</h2>
							<a class="link" href="#">View all</a>
						</div>
						<ul class="convos">
							{conversations.map((c) => (
								<li class="convo">
									<div class="convo-avatar" aria-hidden="true">{c.name.charAt(0)}</div>
									<div class="convo-body">
										<div class="convo-row">
											<strong>{c.name}</strong>
											<span class="convo-time">{c.time}</span>
										</div>
										<div class="convo-row">
											<span class="convo-preview">
												<span class={`tick ${c.status}`} aria-hidden="true">{tick(c.status)}</span>
												{c.preview}
											</span>
											{c.unread > 0 && (
												<span class="badge" aria-label={`${c.unread} unread`}>{c.unread}</span>
											)}
										</div>
									</div>
								</li>
							))}
						</ul>
					</section>
				</div>

				<!-- Templates -->
				<section class="panel" aria-label="Message templates">
					<div class="panel-head">
						<h2>Message templates</h2>
						<a class="link" href="#">Manage</a>
					</div>
					<div class="table-wrap">
						<table class="table">
							<thead>
								<tr>
									<th scope="col">Name</th>
									<th scope="col">Category</th>
									<th scope="col">Language</th>
									<th scope="col">Status</th>
								</tr>
							</thead>
							<tbody>
								{templates.map((t) => (
									<tr>
										<td class="mono">{t.name}</td>
										<td>{t.category}</td>
										<td class="upper">{t.language}</td>
										<td>
											<span class={`pill ${t.status.toLowerCase()}`}>{t.status}</span>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</section>

				<footer class="foot">
					Demo data. Connect the WhatsApp Cloud API to show live metrics.
				</footer>
			</main>
		</div>

		<style>
			:root {
				/* WhatsApp accent */
				--wa-green: #25d366;
				--wa-teal: #128c7e;
				--wa-dark: #075e54;
				/* Neutral scale (SaaS minimalist) */
				--ink: #0b1620;
				--ink-2: #354650;
				--muted: #6b7c87;
				--line: #e6ebef;
				--bg: #f6f8fa;
				--card: #ffffff;
				/* System */
				--radius: 16px;
				--shadow-sm: 0 1px 2px rgba(11, 22, 32, 0.04);
				--shadow-md: 0 8px 24px rgba(11, 22, 32, 0.06);
				--ring: 0 0 0 3px rgba(18, 140, 126, 0.28);
				--ease: cubic-bezier(0.22, 0.61, 0.36, 1);
			}
			* { box-sizing: border-box; }
			body {
				margin: 0;
				background: var(--bg);
				color: var(--ink);
				font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
				font-feature-settings: 'cv11', 'ss01';
				-webkit-font-smoothing: antialiased;
			}
			h1, h2, .card-value { font-family: 'Sora', 'Inter', system-ui, sans-serif; letter-spacing: -0.01em; }

			.skip-link {
				position: absolute; left: -999px; top: 8px; z-index: 10;
				background: var(--wa-dark); color: #fff; padding: 8px 14px; border-radius: 8px;
			}
			.skip-link:focus { left: 8px; }

			:where(a, button, input):focus-visible { outline: none; box-shadow: var(--ring); border-radius: 8px; }

			.layout { display: flex; min-height: 100vh; }

			/* Sidebar */
			.sidebar {
				width: 248px; flex-shrink: 0;
				background: linear-gradient(180deg, #0a6a5e 0%, var(--wa-dark) 100%);
				color: #e9f5f1;
				display: flex; flex-direction: column;
				padding: 20px 16px; gap: 24px;
				position: sticky; top: 0; height: 100vh;
			}
			.brand { display: flex; align-items: center; gap: 12px; padding: 4px 6px; }
			.brand .logo {
				display: grid; place-items: center; width: 40px; height: 40px;
				border-radius: 12px; background: var(--wa-green); color: #04362f;
				box-shadow: 0 6px 16px rgba(37, 211, 102, 0.35);
			}
			.brand-text strong { display: block; font-size: 15px; font-family: 'Sora', sans-serif; }
			.brand-text small { color: #9fc9bf; font-size: 12px; }
			.nav { display: flex; flex-direction: column; gap: 4px; }
			.nav a {
				display: flex; align-items: center; gap: 12px;
				padding: 11px 13px; border-radius: 10px;
				color: #cfe7e0; text-decoration: none; font-size: 14px; font-weight: 500;
				transition: background 0.18s var(--ease), color 0.18s var(--ease), transform 0.18s var(--ease);
			}
			.nav-ico { width: 20px; text-align: center; }
			.nav a:hover { background: rgba(255, 255, 255, 0.09); color: #fff; transform: translateX(2px); }
			.nav a.active {
				background: var(--wa-green); color: #04362f; font-weight: 600;
				box-shadow: 0 6px 16px rgba(37, 211, 102, 0.3);
			}
			.account {
				margin-top: auto; display: flex; align-items: center; gap: 12px;
				padding: 12px; border-radius: 12px;
				background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.06);
			}
			.account .avatar {
				width: 38px; height: 38px; border-radius: 50%;
				background: var(--wa-green); color: #04362f;
				display: grid; place-items: center; font-weight: 700;
			}
			.account-text strong { display: block; font-size: 13px; }
			.account .online { color: #aef0d4; font-size: 11px; display: inline-flex; align-items: center; gap: 5px; }
			.account .online::before {
				content: ''; width: 7px; height: 7px; border-radius: 50%;
				background: var(--wa-green); box-shadow: 0 0 0 3px rgba(37, 211, 102, 0.25);
			}

			/* Main */
			.main { flex: 1; padding: 28px 32px 40px; min-width: 0; }
			.topbar {
				display: flex; justify-content: space-between; align-items: flex-start;
				gap: 16px; flex-wrap: wrap; margin-bottom: 24px;
			}
			.topbar h1 { margin: 0; font-size: 26px; }
			.topbar p { margin: 6px 0 0; color: var(--muted); font-size: 14px; }
			.topbar-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
			.search {
				display: flex; align-items: center; gap: 8px;
				padding: 0 14px; border: 1px solid var(--line); border-radius: 999px;
				background: #fff; box-shadow: var(--shadow-sm);
			}
			.search:focus-within { box-shadow: var(--ring); }
			.search-ico { font-size: 13px; opacity: 0.6; }
			.search input { border: 0; outline: none; padding: 10px 0; font-size: 14px; min-width: 200px; background: transparent; }
			.btn {
				display: inline-flex; align-items: center; gap: 7px;
				padding: 10px 18px; border: 0; border-radius: 999px; cursor: pointer;
				background: var(--wa-teal); color: #fff; font-size: 14px; font-weight: 600;
				box-shadow: 0 6px 16px rgba(18, 140, 126, 0.28);
				transition: background 0.18s var(--ease), transform 0.18s var(--ease);
			}
			.btn:hover { background: var(--wa-dark); transform: translateY(-1px); }
			.btn span { font-size: 16px; line-height: 1; }

			/* Cards */
			.cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 22px; }
			.card {
				background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
				padding: 18px 20px; display: flex; flex-direction: column; gap: 8px;
				box-shadow: var(--shadow-sm);
				transition: box-shadow 0.2s var(--ease), transform 0.2s var(--ease);
			}
			.card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
			.card-top { display: flex; justify-content: space-between; align-items: center; }
			.card-ico {
				width: 38px; height: 38px; display: grid; place-items: center; font-size: 18px;
				border-radius: 11px; background: rgba(37, 211, 102, 0.12);
			}
			.card-value { font-size: 28px; font-weight: 700; line-height: 1.1; }
			.card-label { color: var(--muted); font-size: 13px; }
			.card-delta {
				font-size: 12px; font-weight: 600; padding: 4px 9px; border-radius: 999px;
			}
			.card-delta.up { color: var(--wa-teal); background: rgba(18, 140, 126, 0.1); }
			.card-delta.down { color: #d9534f; background: rgba(217, 83, 79, 0.1); }

			/* Grid */
			.grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 18px; margin-bottom: 22px; }
			.panel {
				background: var(--card); border: 1px solid var(--line);
				border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow-sm);
			}
			.panel-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 16px; }
			.panel-head h2 { margin: 0; font-size: 17px; }
			.panel-sub { margin: 4px 0 0; color: var(--muted); font-size: 12px; }
			.link { color: var(--wa-teal); text-decoration: none; font-size: 13px; font-weight: 600; }
			.link:hover { text-decoration: underline; }
			.legend { display: flex; gap: 16px; font-size: 12px; color: var(--muted); }
			.dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 5px; }
			.dot.sent { background: var(--wa-green); }
			.dot.read { background: var(--wa-teal); }

			/* Chart */
			.chart { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; height: 220px; padding-top: 8px; }
			.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
			.bars { flex: 1; display: flex; align-items: flex-end; gap: 5px; width: 100%; justify-content: center; }
			.bar { position: relative; width: 16px; border-radius: 7px 7px 0 0; transition: filter 0.18s var(--ease); }
			.bar.sent { background: linear-gradient(180deg, var(--wa-green), #1fb558); }
			.bar.read { background: var(--wa-teal); opacity: 0.85; }
			.bar-tip {
				position: absolute; top: -22px; left: 50%; transform: translateX(-50%);
				font-size: 11px; font-weight: 600; color: var(--ink-2);
				opacity: 0; transition: opacity 0.18s var(--ease); white-space: nowrap;
			}
			.bar-col:hover .bar { filter: saturate(1.15) brightness(1.03); }
			.bar-col:hover .bar-tip { opacity: 1; }
			.bar-label { margin-top: 10px; font-size: 12px; color: var(--muted); font-weight: 500; }

			/* Conversations */
			.convos { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
			.convo { display: flex; gap: 12px; padding: 11px 6px; border-bottom: 1px solid var(--line); border-radius: 10px; transition: background 0.15s var(--ease); }
			.convo:hover { background: #f7faf9; }
			.convo:last-child { border-bottom: 0; }
			.convo-avatar {
				width: 44px; height: 44px; flex-shrink: 0; border-radius: 50%;
				background: linear-gradient(135deg, var(--wa-teal), var(--wa-dark)); color: #fff;
				display: grid; place-items: center; font-weight: 600;
			}
			.convo-body { flex: 1; min-width: 0; }
			.convo-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
			.convo-row strong { font-size: 14px; }
			.convo-time { color: var(--muted); font-size: 12px; flex-shrink: 0; }
			.convo-preview { color: var(--muted); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.tick { margin-right: 5px; }
			.tick.read { color: #53bdeb; }
			.tick.delivered, .tick.sent { color: var(--muted); }
			.badge {
				background: var(--wa-green); color: #04362f; font-size: 11px; font-weight: 700;
				min-width: 19px; height: 19px; border-radius: 10px; padding: 0 6px;
				display: grid; place-items: center; flex-shrink: 0;
			}

			/* Table */
			.table-wrap { overflow-x: auto; }
			.table { width: 100%; border-collapse: collapse; font-size: 14px; }
			.table th {
				text-align: left; color: var(--muted); font-weight: 600; font-size: 11px;
				text-transform: uppercase; letter-spacing: 0.04em; padding: 8px 12px; border-bottom: 1px solid var(--line);
			}
			.table td { padding: 13px 12px; border-bottom: 1px solid var(--line); }
			.table tbody tr { transition: background 0.15s var(--ease); }
			.table tbody tr:hover { background: #f7faf9; }
			.table tr:last-child td { border-bottom: 0; }
			.mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; color: var(--ink-2); }
			.upper { text-transform: uppercase; color: var(--muted); }
			.pill { font-size: 12px; font-weight: 600; padding: 4px 11px; border-radius: 999px; }
			.pill.approved { background: #e0f5ec; color: var(--wa-dark); }
			.pill.pending { background: #fff3d6; color: #946200; }
			.pill.rejected { background: #fde2e1; color: #b3261e; }

			.foot { margin-top: 20px; color: var(--muted); font-size: 12px; text-align: center; }

			/* Responsive */
			@media (max-width: 1040px) {
				.cards { grid-template-columns: repeat(2, 1fr); }
				.grid { grid-template-columns: 1fr; }
			}
			@media (max-width: 720px) {
				.sidebar { display: none; }
				.main { padding: 20px 16px 32px; }
				.cards { gap: 12px; }
			}
			@media (prefers-reduced-motion: reduce) {
				* { transition: none !important; }
			}
		</style>
	</body>
</html>
