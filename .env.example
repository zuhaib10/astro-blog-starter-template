# Copy to .env and adjust. Used by docker-compose.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whatsapp
POSTGRES_PORT=5432

# Ports exposed on the host
API_PORT=4000
WEB_PORT=8080

# CORS (the web container proxies same-origin, so * is fine for local)
CORS_ORIGIN=*

# WhatsApp Cloud API — leave blank to run on seed data only.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=changeme
WHATSAPP_GRAPH_VERSION=v21.0
